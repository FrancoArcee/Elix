generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TargetAudience {
  masculino
  femenino
  unisex
}

enum Concentration {
  edt
  edp
  edc
  extrait
}

enum NoteType {
  salida
  corazon
  fondo
  unico
}

// ================================================================
// MODELS
// ================================================================

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  @@map("brands")
}

model Country {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  @@map("countrys")
}

model Type {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  color       Int
  urlImage    String?     @map("url_image")
  description String
  products    Product[]
  offerTypes  OfferType[]

  @@map("types")
}

model Product {
  id             Int            @id @default(autoincrement())
  name           String
  targetAudience TargetAudience @map("target_audience")
  description    String?
  price          Decimal?       @db.Decimal(10, 2)
  sku            String?        @unique
  fraganceFamily String?        @map("fragance_family")
  presentation   String?
  concentration  Concentration?

  brandId Int   @map("brand_id")
  brand   Brand @relation(fields: [brandId], references: [id])

  originId Int?     @map("origin_id")
  origin   Country? @relation(fields: [originId], references: [id])

  typeId Int  @map("type_id")
  type   Type @relation(fields: [typeId], references: [id])

  volumes         ProductVolume[]
  notes           ProductNote[]
  images          ProductImage[]
  featuredProduct FeaturedProduct?

  @@map("products")
}

model Volume {
  id       Int             @id @default(autoincrement())
  volume   Int
  products ProductVolume[]

  @@map("volumes")
}

model ProductVolume {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  volumeId  Int     @map("volume_id")
  product   Product @relation(fields: [productId], references: [id])
  volume    Volume  @relation(fields: [volumeId], references: [id])

  @@unique([productId, volumeId])
  @@map("product_volumes")
}

model Note {
  id       Int           @id @default(autoincrement())
  name     String
  products ProductNote[]

  @@map("notes")
}

model ProductNote {
  id        Int      @id @default(autoincrement())
  type      NoteType
  productId Int      @map("product_id")
  noteId    Int      @map("note_id")
  product   Product  @relation(fields: [productId], references: [id])
  note      Note     @relation(fields: [noteId], references: [id])

  @@unique([productId, noteId, type])
  @@map("product_notes")
}

model ProductImage {
  id           Int      @id @default(autoincrement())
  imageUrl     String?  @map("image_url")
  displayOrder Int?     @map("display_order") // entre 1 y 4 (validar en app layer)
  productId    Int?     @map("product_id")
  product      Product? @relation(fields: [productId], references: [id])

  @@map("product_images")
}

model FeaturedProduct {
  id           Int     @id @default(autoincrement())
  displayOrder Int     @map("display_order")
  productId    Int     @unique @map("product_id")
  product      Product @relation(fields: [productId], references: [id])

  @@map("featured_products")
}

model Information {
  id          Int     @id @default(autoincrement())
  label       String
  title       String
  description String
  imageUrl    String? @map("image_url")

  @@map("information")
}

model PaymentMethod {
  id                  Int                  @id @default(autoincrement())
  method              String
  offerPaymentMethods OfferPaymentMethod[]

  @@map("payment_methods")
}

model Offer {
  id          Int      @id @default(autoincrement())
  discount    Decimal? @db.Decimal(10, 2)
  description String?

  offerPaymentMethods OfferPaymentMethod[]
  offerTypes          OfferType[]

  @@map("offers")
}

model OfferPaymentMethod {
  id              Int           @id @default(autoincrement())
  offerId         Int           @map("offer_id")
  paymentMethodId Int           @map("payment_method_id")
  offer           Offer         @relation(fields: [offerId], references: [id])
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@map("offer_payment_methods")
}

model OfferType {
  id      Int   @id @default(autoincrement())
  offerId Int   @map("offer_id")
  typeId  Int   @map("type_id")
  offer   Offer @relation(fields: [offerId], references: [id])
  type    Type  @relation(fields: [typeId], references: [id])

  @@map("offer_types")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String?
  email    String?
  password String?

  @@map("user")
}
